#!/usr/bin/make -f
# lmn-gpo: a pure-Python toolkit installed into /usr/lib/python3/dist-packages plus
# read-only data under /usr/share/lmn-gpo; debian/install places everything. Nothing is
# compiled or tested at build time, so all four dh_auto_* steps are overridden -- that
# also keeps debhelper's makefile build system from running the top-level Makefile,
# which only wraps dpkg-buildpackage and would recurse.

include /usr/share/dpkg/pkg-info.mk

%:
	dh $@ --with python3

# debian/changelog is the single version source. The installed module has no
# distribution metadata (plain dist-packages install, no PyPI dist-info), so it learns
# its version from this generated file; a source checkout reads the changelog itself
# (lmn_gpo/__init__.py). debian/clean removes it again.
override_dh_auto_build:
	printf '"""Generated by debian/rules from debian/changelog -- do not edit."""\n__version__ = "%s"\n' \
		'$(DEB_VERSION)' > lmn_gpo/_version.py

override_dh_auto_test override_dh_auto_install override_dh_auto_clean:
	@:

# Admins read README.md and docs/*.md on the server itself; gzipping them would only
# hide them. Everything else (the changelog) is compressed as usual.
override_dh_compress:
	dh_compress -X.md
