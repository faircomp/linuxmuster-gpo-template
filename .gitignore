# Site-/customer-specific answers (contain bind passwords etc.)
site.yaml
*.site.yaml
/etc/linuxmuster/lmn-gpo/

# Wallpapers (customer-specific, not part of the repo)
wallpapers/*.jpg
wallpapers/*.jpeg
wallpapers/*.png
wallpapers/*.bmp

# Build artifacts. dpkg-buildpackage writes the .deb, .changes, .buildinfo, .dsc and
# the source tarball one level ABOVE this tree, so nothing of it lands here; dist/ and
# build/ stay ignored for leftovers from older builds.
dist/
build/
# Generated into the source tree by debian/rules (override_dh_auto_build) and removed
# again by debian/clean, so it never belongs to a commit.
lmn_gpo/_version.py

# Python
__pycache__/
*.py[cod]

# Misc
*.log
.DS_Store
